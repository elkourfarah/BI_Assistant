# ==============================================================================
# Git Ignore - Assistant BI Keyrus
# ==============================================================================

# 1. Variables d'environnement & Secrets (CRITIQUE : Ne jamais committer !)
.env
*.env
!.env.example
*.pem
*.key
credentials.json

# 2. Environnements virtuels Python
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 3. Cache Python & Fichiers compilés
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 4. Fichiers générés / Outputs de démonstration
# On ignore les sorties générées pour garder le dépôt propre
output/*.docx
output/*.json
output/*.mmd
output/*.png
!output/.gitkeep

# 5. IDEs & Éditeurs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# 6. Divers
*.log
scratch/

# 7. Présentations, scripts de diaporama & notes internes de compréhension
*.pptx
Presentation_BI_Keyrus*
SPEECH_PRESENTATION.md
create_presentation.py
slide_preview/
