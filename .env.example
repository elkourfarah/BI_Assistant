# ==============================================================================
# Configuration des variables d'environnement - Assistant BI Keyrus
# ==============================================================================
# Renommez ce fichier en ".env" et renseignez votre propre clé d'API Groq :
# Ex: cp .env.example .env

# Clé d'API Groq (obtenable gratuitement sur https://console.groq.com/keys)
GROQ_API_KEY=votre_cle_groq_ici

# Modèle Groq utilisé par défaut
GROQ_MODEL=openai/gpt-oss-20b
